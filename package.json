{
  "name": "get",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev-vars": "bun run scripts/dev-vars.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "bun --env-file=.env run scripts/migrate.ts",
    "publish": "bun --env-file=.env run scripts/publish.ts",
    "seed-build-tool": "bun --env-file=.env run scripts/seed-build-tool.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@upstash/qstash": "^2.12.0",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "aws4fetch": "1.0.20",
    "hono": "4.13.13",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^22.10.2",
    "@types/semver": "^7.7.0",
    "jose": "6.2.13",
    "typescript": "^7.0.0",
    "vitest": "5.0.5",
    "wrangler": "^4.70.0"
  }
}
