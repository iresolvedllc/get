{
  "name": "get",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "bun --env-file=.env.get run scripts/migrate.ts",
    "publish": "bun --env-file=.env.get run scripts/publish.ts",
    "seed-build-tool": "bun --env-file=.env.get run scripts/seed-build-tool.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@neondatabase/serverless": "1.2.0",
    "@upstash/qstash": "^2.12.0",
    "hono": "4.13.13",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "^22.10.2",
    "@types/semver": "^7.7.0",
    "jose": "6.2.13",
    "typescript": "^6.0.2",
    "vitest": "5.0.5",
    "wrangler": "^4.70.0"
  }
}
